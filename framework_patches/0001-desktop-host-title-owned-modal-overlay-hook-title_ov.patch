From 35d3b94f59c74f85e4df54d87c093b266f67973f Mon Sep 17 00:00:00 2001
From: Rodrigo <32554920+RodriLoy@users.noreply.github.com>
Date: Sun, 18 Oct 2026 20:05:31 -0600
Subject: [PATCH 1/3] desktop host: title-owned modal overlay hook
 (title_overlay_*)

A port can supply its own frozen-guest panel (a pause menu) through the same
modal pump as the save-state browser: poll_open per iteration with the human
input word and raw gamepad buttons, handle_key / poll_nav / image while open,
closed() before the guest resumes. SNESRECOMP_TITLE_OVERLAY_DUMP_DIR writes
every composited present for headless checks.

---
 runner/src/desktop/host_main.c | 60 ++++++++++++++++++++++++++++++++++
 runner/src/desktop/host_main.h | 18 ++++++++++
 2 files changed, 78 insertions(+)

diff --git a/runner/src/desktop/host_main.c b/runner/src/desktop/host_main.c
index 3bc3905..5cc5242 100644
--- a/runner/src/desktop/host_main.c
+++ b/runner/src/desktop/host_main.c
@@ -1848,10 +1848,13 @@ static void OverlaySelftestPadTick(unsigned pump) {
  * shapes: the save-state browser is an opaque full-rect panel, the rewind
  * filmstrip belongs across the bottom third of the frame, annotating the
  * moment it describes. */
+static bool g_title_overlay_active;  /* title_overlay_* modal is up */
 static void PresentFrozenWithOverlay(void) {
   const uint32_t *panel = NULL;
   int pw = 0, ph = 0;
   int is_menu = snes_savestate_menu_overlay_image(&panel, &pw, &ph) && panel;
+  if (!is_menu && g_title_overlay_active && g_game->title_overlay_image)
+    is_menu = g_game->title_overlay_image(&panel, &pw, &ph) && panel;
   if (!is_menu && !(snes_rewind_overlay_image(&panel, &pw, &ph) && panel))
     panel = NULL;
 
@@ -1924,9 +1927,59 @@ static void PresentFrozenWithOverlay(void) {
     }
   }
 
+  /* SNESRECOMP_TITLE_OVERLAY_DUMP_DIR=<dir>: write every composited title
+   * overlay present as <dir>/title_overlay_NNNN.ppm, so a port's pause menu
+   * can be checked headlessly the way OVERLAY_DUMP checks the browser. */
+  if (g_title_overlay_active && panel) {
+    static unsigned title_dump_n;
+    const char *dir = HostGetenv("TITLE_OVERLAY_DUMP_DIR");
+    if (dir) {
+      char path[1024];
+      snprintf(path, sizeof(path), "%s/title_overlay_%04u.ppm", dir, title_dump_n++);
+      FILE *f = fopen(path, "wb");
+      if (f) {
+        fprintf(f, "P6\n%d %d\n255\n", draw_w, draw_h);
+        for (int y = 0; y < draw_h; y++) {
+          const uint32_t *row = (const uint32_t *)(pixel_buffer + (size_t)y * (size_t)pitch);
+          for (int x = 0; x < draw_w; x++) {
+            uint32_t p = row[x];
+            fputc((p >> 16) & 0xFF, f); fputc((p >> 8) & 0xFF, f); fputc(p & 0xFF, f);
+          }
+        }
+        fclose(f);
+      }
+    }
+  }
+
   g_renderer_funcs.EndDraw();
 }
 
+/* Title-owned modal overlay (SnesDesktopHostGame.title_overlay_*): the same
+ * frozen-guest pump as the save-state browser, with the port supplying the
+ * panel and the input handling. */
+static void RunTitleOverlayLoop(bool *running) {
+  unsigned frames = 0;
+  host_report_breadcrumb("title overlay OPEN - guest frozen until it closes");
+  g_overlay_modal = true;
+  g_title_overlay_active = true;
+  SetAudioPaused(true);
+  while (*running && g_game->title_overlay_is_open && g_game->title_overlay_is_open()) {
+    PumpOverlayEvents(running, g_game->title_overlay_handle_key);
+    if (g_game->title_overlay_poll_nav)
+      g_game->title_overlay_poll_nav(OverlayNavInputs(), SDL_GetTicks());
+    PresentFrozenWithOverlay();
+    SDL_Delay(8);
+    frames++;
+  }
+  g_title_overlay_active = false;
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  OverlayNoteClosed();
+  if (g_game->title_overlay_closed) g_game->title_overlay_closed();
+  host_report_breadcrumb("title overlay CLOSED after %u pumps - guest resuming", frames);
+}
+
 /* Save-state browser's modal pump. The guest is FROZEN throughout: this loop
  * never calls RtlRunFrame and never calls the game's draw_ppu_frame, which is
  * what makes "save right here" a definite point in time. */
@@ -4158,6 +4211,13 @@ error_reading:;
       continue;   /* guest was frozen: no frame to run or present */
     }
     g_open_launcher_hotkey = 0;
+    if (game->title_overlay_poll_open && !snes_rewind_is_open() &&
+        !snes_savestate_menu_is_open() &&
+        game->title_overlay_poll_open(OverlayNavInputs(), g_gamepad[0].modifiers)) {
+      RunTitleOverlayLoop(&running);
+      if (!running) break;
+      continue;   /* guest was frozen: no frame to run or present */
+    }
     if ((g_rewind_hotkey || PadGesturePressed(&g_rewind_gesture)) && !snes_rewind_is_open() &&
         !snes_savestate_menu_is_open()) {
       /* Refused during netplay by snes_rewind_open() itself: one machine
diff --git a/runner/src/desktop/host_main.h b/runner/src/desktop/host_main.h
index 03b6f06..75404de 100644
--- a/runner/src/desktop/host_main.h
+++ b/runner/src/desktop/host_main.h
@@ -197,6 +197,24 @@ typedef struct SnesDesktopHostGame {
   /* After the gameplay loop ends, before SDL resources are destroyed or a
    * relaunch begins. Stop title-owned workers here. No further frames run. */
   void (*on_shutdown)(void);
+
+  /* Title-owned modal overlay: a pause menu, or any panel a port draws
+   * itself. poll_open is called once per host iteration, before the guest
+   * frame, with the human input word (SNES_PAD_* bits) and seat 0's raw
+   * gamepad button set (1 << kGamepadBtn_*, so L3/R3 are visible); return
+   * nonzero to open. While open the guest is FROZEN exactly as under the
+   * save-state browser -- no RtlRunFrame, no draw_ppu_frame, audio paused --
+   * so the port may read and write WRAM at a clean frame boundary. Key
+   * presses (SDL keycodes) go to handle_key, the pad word to poll_nav once
+   * per pump, and image() supplies an ARGB panel that is blitted, centred,
+   * over the frozen frame. The loop ends when is_open() returns 0; closed()
+   * then runs before the guest resumes. All optional; NULL poll_open = none. */
+  int  (*title_overlay_poll_open)(uint32_t inputs, uint32_t gamepad_raw);
+  int  (*title_overlay_is_open)(void);
+  void (*title_overlay_handle_key)(int key, int repeat);
+  void (*title_overlay_poll_nav)(uint32_t inputs, uint32_t now_ms);
+  int  (*title_overlay_image)(const uint32_t **panel, int *w, int *h);
+  void (*title_overlay_closed)(void);
 } SnesDesktopHostGame;
 
 /* The whole program. Returns the process exit code. */

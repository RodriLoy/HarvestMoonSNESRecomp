 src/common/launcher_i18n.cpp                 | 560 +++++++++++++++++-
 src/common/launcher_i18n.h                   |  44 ++
 src/common/launcher_ng_capi.c                |   3 +
 4 files changed, 891 insertions(+), 295 deletions(-)

diff --git a/src/common/backends/imgui/launcher_imgui.cpp b/src/common/backends/imgui/launcher_imgui.cpp
index 4dc73c7..37aaeaf 100644
--- a/src/common/backends/imgui/launcher_imgui.cpp
+++ b/src/common/backends/imgui/launcher_imgui.cpp
@@ -94,6 +94,44 @@ static const char* ui_text(const char* en) {
     return launcher_i18n_text(en);
 }
 
+/* A key or pad-button name on a binding chip: translated only where an
+ * explicit "Name||button" entry exists ("Back" the pad button must not
+ * become "Volver" the navigation verb). */
+static const char* button_text(const char* name) {
+    static std::string key;
+    key = std::string(name ? name : "") + "||button";
+    return launcher_i18n_text(key.c_str());
+}
+
+/* Header language picker: the current language's native name; the popup
+ * lists every language (built-in and game-registered). The choice is saved
+ * to config.ini right away, so the next launch opens in it. */
+extern "C" const char* g_launcher_config_path;
+static void language_picker(float w, float h) {
+    const char* cur = launcher_i18n_language();
+    const char* name = cur;
+    for (int i = 0; i < launcher_i18n_language_count(); ++i)
+        if (std::strcmp(launcher_i18n_language_code(i), cur) == 0)
+            name = launcher_i18n_language_name(i);
+    /* A combo, padded to the height of the header buttons beside it. */
+    const float pad_y = (h - ImGui::GetFontSize()) * 0.5f;
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding,
+                        ImVec2(ImGui::GetStyle().FramePadding.x, pad_y > 0 ? pad_y : 0));
+    ImGui::SetNextItemWidth(w);
+    if (ImGui::BeginCombo("##language", name)) {
+        for (int i = 0; i < launcher_i18n_language_count(); ++i) {
+            const char* code = launcher_i18n_language_code(i);
+            if (ImGui::Selectable(launcher_i18n_language_name(i),
+                                  std::strcmp(code, cur) == 0)) {
+                launcher_i18n_set_language(code);
+                launcher_i18n_save_config(g_launcher_config_path);
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::PopStyleVar();
+}
